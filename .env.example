# Copie para .env e preencha os valores locais (não envie .env ao Git).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_GERADA_NO_SEU_COMPUTADOR
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_PASSWORD=SUBSTITUA_PELA_SENHA_DO_BANCO_LOCAL_EXISTENTE
# Obrigatória somente para emitir JWT ao microserviço; compartilhe-a com o verificador.
# MICROSERVICO_JWT_SIGNING_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
# RabbitMQ usado pelo worker do repositório público. Não inclua credenciais no Git.
# RABBITMQ_URL=amqp://USUARIO:SENHA@127.0.0.1:5672/%2F
# REPOSITORIO_FILA=allteam.repositorio.indexar
# Para o Compose local (AMQP 5673, painel 15673):
# RABBITMQ_USER=repositorio
# RABBITMQ_PASSWORD=SUBSTITUA_POR_SENHA_ALEATORIA
# RABBITMQ_URL=amqp://repositorio:SENHA@127.0.0.1:5673/%2F
