+"""Barreira adicional de rede para rotas administrativas (não substitui as roles)."""
+import ipaddress
+from django.conf import settings
+from django.http import HttpResponseForbidden
+
+
+class RedeAdministrativaMiddleware:
+    PREFIXOS = ('/admin/', '/entrar/', '/equipe/', '/monografias/', '/api-auth/', '/api/')
+    EXCECOES = ('/api/usuarios/', '/api/publico/')
+
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request):
+        if getattr(settings, 'ADMIN_NETWORK_RESTRICTION_ENABLED', False):
+            path = request.path
+            protegido = any(path.startswith(prefixo) for prefixo in self.PREFIXOS)
+            excecao = any(path.startswith(prefixo) for prefixo in self.EXCECOES)
+            if protegido and not excecao:
+                redes = getattr(settings, 'ADMIN_ALLOWED_CIDRS', ())
+                try:
+                    ip = ipaddress.ip_address(request.META.get('REMOTE_ADDR', ''))
+                    permitido = any(ip in ipaddress.ip_network(cidr, strict=False) for cidr in redes)
+                except ValueError:
+                    permitido = False
+                if not permitido:
+                    return HttpResponseForbidden('Acesso administrativo restrito à rede institucional.')
+        return self.get_response(request)
